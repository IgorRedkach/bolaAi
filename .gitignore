# Data: ignore Chroma/generated; keep data/knowledge and data/training for Docker build
data/chroma/
data/*.db
*.db
chroma/

# Shared docs: user-supplied API docs (not committed); keep .gitkeep
shared_docs/*
!shared_docs/.gitkeep

# Inbox: scratch/staging area
inbox/

# Python
__pycache__/
*.py[cod]
*$py.class
.eggs/
dist/
build/
*.egg-info/
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Agent E2E loop artifacts (regenerated each loop)
docs/e2e_loop_last_run.json
docs/live_e2e_test_timings.md

# Large generated training cycles (keep baseline artifacts only)
data/training/ai_cycles/
data/training/ai_tasks/
data/training/generated_cycles/
data/training/retrain_runs/

# Testing
.coverage
htmlcov/
.pytest_cache/

# Models — fully ignored; model weights are downloaded at Docker build time from GitHub Releases.
models/*
*.bin

# Env
.env
.env.local

# Salesforce DX (auto-generated tooling)
.sfdx/

# OS
.DS_Store
Thumbs.db
