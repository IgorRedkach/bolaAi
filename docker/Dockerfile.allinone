# BOLA AI — All-in-one image: Ollama + pre-baked 3B-class model + taught RAG knowledge + app.
# The model is downloaded, taught with few-shot examples, and RAG knowledge is pre-loaded
# ALL during BUILD so the image is 100% self-contained. No internet needed at runtime.
# Users run: docker run -p 8000:8000 -v ~/my-docs:/shared-docs ghcr.io/igorredkach/bolai:latest
FROM python:3.11-slim AS base

# Install ollama binary (keep curl and ca-certificates; skip autoremove to preserve /bin/sh)
RUN apt-get update && apt-get install -y --no-install-recommends curl zstd ca-certificates && \
    curl -fsSL https://ollama.com/download/ollama-linux-amd64.tar.zst | tar x --zstd -C /usr && \
    rm -rf /var/lib/apt/lists/*

# App dependencies
WORKDIR /app
# CPU-only PyTorch first — otherwise pip pulls CUDA/NVIDIA wheels (~multi-GB) and GitHub Actions runners hit ENOSPC during pip install.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch
RUN pip install --no-cache-dir fastapi "uvicorn[standard]" httpx pydantic chromadb sentence-transformers python-multipart jinja2 pyyaml

# App source + training data
COPY pyproject.toml ./
COPY src/ ./src/
COPY data/ /app/data/
COPY models/published/ /app/models/published/

# Bake Modelfile into image (includes 15 few-shot teaching examples)
COPY docker/Modelfile /app/Modelfile

# --- Stage 1: Model setup is deferred to first-run entrypoint ---
# The trained model bundle in /app/models/published/ will be imported on first container start.
# On first run: bundle is extracted → ollama create bola-analyzer from merged 0.5B weights.
# Fallback: if bundle import fails and BOLA_AI_ALLOW_MODEL_PULL=1, pulls qwen2.5-coder:3b.

# --- Stage 2: Pre-load RAG knowledge base during build ---
# Loads all 215 BOLA training examples + knowledge patterns into ChromaDB.
# Also downloads and caches the sentence-transformers embedding model (~90 MB).
# Result: /data/chroma/ contains the fully indexed knowledge base.
RUN PYTHONPATH=/app/src BOLA_AI_DATA=/data \
    python /app/src/training/load_knowledge.py && \
    echo "[build] RAG knowledge base pre-loaded into /data/chroma."

# Entrypoint
COPY docker/entrypoint-allinone.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV BOLA_AI_DATA=/data
ENV OLLAMA_HOST=127.0.0.1:11434
ENV OLLAMA_BASE_URL=http://127.0.0.1:11434
ENV OLLAMA_MODEL=bola-analyzer
ENV PYTHONPATH=/app/src
ENV BOLA_AI_PRELOAD=1
# Safer defaults inside container; sampling params also set in llm.py + Modelfile.
ENV OLLAMA_FLASH_ATTENTION=0
ENV BOLA_AI_OLLAMA_TEMPERATURE=0.7
ENV BOLA_AI_OLLAMA_TOP_P=0.9
ENV BOLA_AI_OLLAMA_TOP_K=40
ENV BOLA_AI_OLLAMA_REPEAT_PENALTY=1.1

EXPOSE 8000

VOLUME ["/shared-docs"]

ENTRYPOINT ["/entrypoint.sh"]
