# BOLA AI — All-in-one image: Ollama + pre-baked qwen2.5-coder:3b + Modelfile + RAG knowledge + app.
# Model is pulled from Ollama and taught at BUILD time — fully offline at runtime.
# Users run: docker run -p 8000:8000 -v ~/my-docs:/shared-docs ghcr.io/igorredkach/bolai:latest
FROM python:3.11-slim AS base

# Pinned Ollama — matches tested version; keeps llama_sampler stable on CPU.
ARG OLLAMA_VERSION=0.20.5

# Install ollama binary
RUN apt-get update && apt-get install -y --no-install-recommends curl zstd ca-certificates && \
    curl -fsSL "https://github.com/ollama/ollama/releases/download/v${OLLAMA_VERSION}/ollama-linux-amd64.tar.zst" | tar x --zstd -C /usr && \
    rm -rf /var/lib/apt/lists/*

# App dependencies
WORKDIR /app
# CPU-only PyTorch first — prevents CUDA wheel pull which causes ENOSPC on CI runners.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch
RUN pip install --no-cache-dir fastapi "uvicorn[standard]" httpx pydantic chromadb sentence-transformers python-multipart jinja2 pyyaml

# App source + training data
COPY pyproject.toml ./
COPY src/ ./src/
COPY data/ /app/data/

# Bake Modelfile (system prompt + 15 domain few-shot examples)
COPY docker/Modelfile /app/Modelfile

# Bake HAR specialist Modelfile
COPY docker/Modelfile.bola-har /app/Modelfile.bola-har

# --- Stage 1: Pre-bake qwen2.5-coder:3b + create bola-analyzer model at BUILD time ---
# This makes the image fully self-contained: no internet access needed at runtime.
# We start Ollama, pull the base model, apply our Modelfile, then shut Ollama down.
# The /root/.ollama/models directory is captured into the image layer.
RUN /bin/bash -c '\
    OLLAMA_DEBUG=WARN ollama serve &>/tmp/ollama-build.log & \
    OLLAMA_PID=$! && \
    echo "[build] Waiting for Ollama..." && \
    for i in $(seq 1 60); do ollama list >/dev/null 2>&1 && break; sleep 2; done && \
    echo "[build] Pulling qwen2.5-coder:3b..." && \
    ollama pull qwen2.5-coder:3b && \
    echo "[build] Creating bola-analyzer model from Modelfile..." && \
    ollama create bola-analyzer -f /app/Modelfile && \
    echo "[build] Model baked successfully." && \
    kill $OLLAMA_PID 2>/dev/null; wait $OLLAMA_PID 2>/dev/null; true'

# --- Stage 1b: Download + bake bola-har specialist model (Q4_K_M GGUF from GitHub Releases) ---
# The GGUF (~1.8 GiB) is stored as a GitHub Release asset (not in git).
# Produced by: scripts/merge_adapter_fp16.py + llama-quantize Q4_K_M.
# Uses a Docker build secret (gh_token) to authenticate the download from a private repo.
# Pass at build time: --secret id=gh_token,env=GITHUB_TOKEN
# Asset ID 407507931 = bola-har-q4km.gguf in release bola-har-v1.
ARG BOLA_HAR_ASSET_ID=407507931
RUN --mount=type=secret,id=gh_token \
    mkdir -p /app/models/merged && \
    GH_TOKEN=$(cat /run/secrets/gh_token) && \
    echo "[build] Downloading bola-har Q4_K_M GGUF from GitHub Release asset ${BOLA_HAR_ASSET_ID}..." && \
    curl -fsSL \
         -H "Authorization: token ${GH_TOKEN}" \
         -H "Accept: application/octet-stream" \
         "https://api.github.com/repos/IgorRedkach/bolaAi/releases/assets/${BOLA_HAR_ASSET_ID}" \
         -o /app/models/merged/bola-har-q4km.gguf && \
    ls -lh /app/models/merged/bola-har-q4km.gguf && \
    echo "[build] GGUF download complete."
RUN /bin/bash -c '\
    OLLAMA_DEBUG=WARN ollama serve &>/tmp/ollama-build-har.log & \
    OLLAMA_PID=$! && \
    echo "[build] Waiting for Ollama (bola-har)..." && \
    for i in $(seq 1 60); do ollama list >/dev/null 2>&1 && break; sleep 2; done && \
    echo "[build] Creating bola-har specialist model..." && \
    ollama create bola-har -f /app/Modelfile.bola-har && \
    echo "[build] bola-har model baked successfully." && \
    kill $OLLAMA_PID 2>/dev/null; wait $OLLAMA_PID 2>/dev/null; true'

# --- Stage 2: Pre-load RAG knowledge base during build ---
# Loads canonical knowledge patterns from data/knowledge/*.md into ChromaDB.
# Training examples are NOT loaded — they live in data/training/ and are used
# only by the training pipeline, never by the inference RAG store.
# Also downloads and caches the sentence-transformers embedding model (~90 MB).
RUN PYTHONPATH=/app/src BOLA_AI_DATA=/data \
    python /app/src/training/load_knowledge.py && \
    echo "[build] RAG knowledge base pre-loaded into /data/chroma."

# Entrypoint
COPY docker/entrypoint-allinone.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV BOLA_AI_DATA=/data
ENV OLLAMA_HOST=127.0.0.1:11434
ENV OLLAMA_BASE_URL=http://127.0.0.1:11434
ENV OLLAMA_MODEL=bola-analyzer
ENV PYTHONPATH=/app/src
ENV BOLA_AI_PRELOAD=1
ENV OLLAMA_FLASH_ATTENTION=0
ENV BOLA_AI_OLLAMA_TEMPERATURE=0.7
ENV BOLA_AI_OLLAMA_TOP_P=0.9
ENV BOLA_AI_OLLAMA_TOP_K=40
ENV BOLA_AI_OLLAMA_REPEAT_PENALTY=1.1

EXPOSE 8000

VOLUME ["/shared-docs"]

ENTRYPOINT ["/entrypoint.sh"]
